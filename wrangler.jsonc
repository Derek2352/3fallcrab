{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Worker name: the live Worker in the Cloudflare dashboard (it holds the leaderboard database), also
  // https://freefallcrab.<your-subdomain>.workers.dev. Deploys from GitHub go to this Worker either way; keeping the
  // name the same here means a deploy from a computer goes there too, instead of creating a second, empty one.
  "name": "freefallcrab",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  // Leaderboard database. No "database_id" needed: the first deploy creates the D1 database.
  // A deploy from your computer writes the id back into this file (commit that change).
  // Deploys from GitHub keep reusing the database already bound to the Worker.
  "d1_databases": [
    { "binding": "DB" }
  ],
  "vars": {
    "TIMEZONE": "Asia/Hong_Kong",
    "LEADERBOARD_CLOSED": "0"
  },
  // ADMIN_TOKEN (and IP_SALT) are passwords: set them in the Cloudflare dashboard as type "Secret", never in this
  // file. This repository is public, and the admin page shows players' emails. Deploys never touch secrets, and
  // keep_vars stops deploys from deleting any plain variables added in the dashboard, so both stay in sync.
  "keep_vars": true,
  // Your domain. 3fallcrab.com must be a zone in the same Cloudflare account.
  // On a deploy from GitHub, Cloudflare points these two hostnames at this Worker (replacing their
  // existing A/AAAA/CNAME records; other records such as email are untouched). The workers.dev
  // address keeps working as a backup. Using a different domain? Change or remove these two lines.
  "routes": [
    { "pattern": "3fallcrab.com", "custom_domain": true },
    { "pattern": "www.3fallcrab.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
